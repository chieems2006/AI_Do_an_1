# Sao chép thành .env (đã có trong .gitignore) rồi điền. KHÔNG commit key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# 1 = không gọi Gemini thật (test/demo offline)
MSA_LLM_MOCK=0
# Hạ "thinking" để giảm token/latency (đo thật: budget 0 → 0 token thinking). Để trống = mặc định của model.
GEMINI_THINKING_BUDGET=0
# Lưu ý (Tác nhân 3): gemini-3.5-flash-lite trả HTTP 400 với thinkingBudget=0 → để trống khi dùng flash-lite (mặc định không suy nghĩ).
GEMINI_THINKING_LEVEL=
GEMINI_TIMEOUT=30
GEMINI_MAX_RETRIES=3
# Free tier đo được 11/2026: 5 request/phút và 20 request/ngày cho mỗi project/model → đặt RPM ≤ 4
GEMINI_RPM=4
MSA_LLM_CACHE=1
MSA_LLM_CACHE_PATH=data/cache/llm_cache.sqlite
# Đơn giá để quy token → tiền: [cần xác minh – điền theo bảng giá Google hiện hành]
GEMINI_PRICE_IN_PER_1M=
GEMINI_PRICE_OUT_PER_1M=
# Backend
MSA_CATALOG=data/processed/catalog_v1.parquet
MSA_IMAGES_ROOT=data
MSA_CACHE_DIR=results/cache
MSA_LOG_DIR=logs
MSA_VISUAL_BACKEND=clip
# τ_v = 0.25 KHÔNG loại được ảnh ngoài phạm vi nào (đo thật) → đề xuất đọc τ_v theo model từ indexes/<model>/config.json
# (DINOv2-S 0.5923; FashionCLIP 0.7039) – QUYET_DINH_CAN_CHOT mục C. τ_r thực tế của RAG Chiến = 0.0.
MSA_TAU_V=0.25
MSA_TAU_R=0.35
# Đường dẫn dữ liệu dùng chung (thay cho đường dẫn tuyệt đối trong code):
MSA_SHARED_DATA=
MSA_RAW_DIR=
MSA_TORCH_THREADS=2
